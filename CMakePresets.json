{
  "version": 4,
  "configurePresets": [
    {
      "name": "desktop-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_DESKTOP_CLIENT": "ON",
        "BUILD_BACKEND": "OFF",
        "BUILD_PROJECT_TESTS": "ON"
      }
    },
    {
      "name": "backend-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/backend",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_DESKTOP_CLIENT": "OFF",
        "BUILD_BACKEND": "ON",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop-debug",
      "configurePreset": "desktop-debug"
    },
    {
      "name": "backend-debug",
      "configurePreset": "backend-debug"
    }
  ]
}
